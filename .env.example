# Load this file from the repository root (copy to .env).
# Relative database paths are also resolved from the working directory.
# Optional Chess.com username
CHESS_COACH_CHESSCOM_USERNAME=

# Application logging
CHESS_COACH_LOG_LEVEL=INFO

# Database
CHESS_COACH_DATABASE_PATH=data/chess_coach.db

# Stockfish
CHESS_COACH_STOCKFISH_EXECUTABLE=stockfish
CHESS_COACH_STOCKFISH_THREADS=4
CHESS_COACH_STOCKFISH_HASH_MB=512

# Ollama
CHESS_COACH_OLLAMA_HOST=http://localhost:11434
CHESS_COACH_OLLAMA_MODEL=qwen3.5:4b-q4_K_M
